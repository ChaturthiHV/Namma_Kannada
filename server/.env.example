# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL 13+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/namma_kannada
# Set to true for managed Postgres that requires SSL (Neon, Supabase, Render, RDS...)
DATABASE_SSL=false

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# First admin account, created by `npm run db:migrate` if it does not exist yet.
# CHANGE THE PASSWORD before deploying anywhere public.
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# --- Audio uploads ---
UPLOAD_DIR=uploads
MAX_AUDIO_MB=3
# Optional absolute prefix for audio URLs (e.g. https://api.example.com)
PUBLIC_URL=

# --- Misc ---
APP_TIMEZONE=Asia/Kolkata

# --- Pronunciation scoring (optional) ---
# Any OpenAI-compatible speech-to-text endpoint that supports Kannada (language=kn), for example a self-hosted
# faster-whisper / whisper.cpp server, or OpenAI. Leave ASR_URL empty to disable: the app falls back to self-rating.
ASR_URL=
ASR_MODEL=whisper-1
ASR_API_KEY=

# --- OTP (password reset / OTP login) ---
# POSTed as JSON {to, message} to this URL, so you can plug in MSG91, Twilio, Fast2SMS, etc. via a tiny webhook.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Development only: print the OTP in the server log and return it in the API response so you can test without SMS.
OTP_DEV_ECHO=true
